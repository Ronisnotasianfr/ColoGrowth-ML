# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IPYNB checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Large data files (download with preprocess.py or reproduce.sh)
data/raw/
data/processed/
data/gdsc/

# Trained model checkpoints (reproducible via reproduce.sh)
models/*.joblib
models/*.pkl
models/*.keras

# Generated figures (reproducible, but CSVs tracked for judge review)
results/*.png
results/*.pdf
results/*.txt

# Generated paper outputs (reproducible from .tex sources)
paper/*.pdf
paper/*.docx

# LaTeX source/auxiliary files
*.ltx
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz

