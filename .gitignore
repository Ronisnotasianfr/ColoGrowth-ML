.agents/
.opencode/
.claude/

# Backup / temp files
.backup_pre_competition/
COMPLETION_LOG.md

# IDE settings
.idea/
.vscode/

# Mentor outreach utilities (not project deliverables)
files/generate_*
files/START_HERE_*
files/SESSION_1_*
files/email_*
files/HOW_TO_USE_*

